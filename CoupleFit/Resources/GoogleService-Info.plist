<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ⚠️ 占位文件 —— 必须替换！

  这是模板，值全部是占位符。App 能编译启动，但 Firebase 功能不会工作。
  请按 README「配置 Firebase」一节操作：
    1. 打开 https://console.firebase.google.com
    2. 创建项目 → 添加 iOS 应用（Bundle ID: com.couplefit.app）
    3. 下载真实的 GoogleService-Info.plist，覆盖本文件
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>__API_KEY__</string>
	<key>GCM_SENDER_ID</key>
	<string>__GCM_SENDER_ID__</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.couplefit.app</string>
	<key>PROJECT_ID</key>
	<string>__PROJECT_ID__</string>
	<key>STORAGE_BUCKET</key>
	<string>__PROJECT_ID__.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>CLIENT_ID</key>
	<string>__CLIENT_ID__</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.__REVERSED_CLIENT_ID__</string>
</dict>
</plist>
